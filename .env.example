# ==========================================
# Open Agent Hackathon 2026 - Team Indus Environment Configuration
# ==========================================

# 1. NVIDIA NIM Configuration
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# 2. Meterless Agent Engine Configuration
# Get your token and engine endpoints from meterless.ai
METERLESS_API_KEY=meterless_token_here
METERLESS_ENGINE=world-model
METERLESS_ENDPOINT=https://api.meterless.ai/v1

# 3. Zetaris Cloud Gateway Semantic Layer
ZETARIS_HOST=localhost
ZETARIS_PORT=10000
ZETARIS_USER=admin
ZETARIS_PASSWORD=admin
ZETARIS_DATABASE=default

# 4. App & API Settings
APP_ENV=development
APP_PORT=8000
DEBUG=True
